/* ============================================================
   장기 덱빌딩 디펜스 - 3D 섀도우 엘리먼트 레이어링 테마
   (모든 UI에 piece-shadow와 동일한 전용 섀도우 엘리먼트 적용)
   ============================================================ */

/* ════════════════════════════════════════════════════════════ */
/* 0. 테마 색상 변수 (CSS Custom Properties) */
/* ════════════════════════════════════════════════════════════ */

:root {
    --theme-primary: rgb(2, 132, 199);
    --theme-primary-dark: rgb(3, 105, 161);
    --theme-primary-light: rgb(56, 189, 248);
    --theme-primary-bg: rgb(240, 249, 255);
    --theme-primary-tint: rgb(224, 242, 254);
    --theme-primary-border: rgb(186, 230, 253);
    --theme-primary-hover: rgba(2, 132, 199, 0.15);
    --theme-primary-move: rgba(2, 132, 199, 0.35);
    --theme-primary-move-hover: rgba(2, 132, 199, 0.65);
    --theme-screen-bg: rgb(246, 250, 254);
    --theme-board-bg: #E8F7FF;
    --theme-board-border: rgb(2, 132, 199);
    --theme-board-shadow: rgb(3, 105, 161);
    --theme-board-line: rgb(2, 90, 150);
}

/* 🟢 난이도 1: 하 (입문) - 깊이감 있는 딥 에메랄드 포레스트 그린 */
.theme-diff-easy {
    --theme-primary: rgb(5, 150, 105);
    --theme-primary-dark: rgb(4, 120, 87);
    --theme-primary-light: rgb(16, 185, 129);
    --theme-primary-bg: rgb(236, 253, 245);
    --theme-primary-tint: rgb(209, 250, 229);
    --theme-primary-border: rgb(110, 231, 183);
    --theme-primary-hover: rgba(5, 150, 105, 0.15);
    --theme-primary-move: rgba(5, 150, 105, 0.35);
    --theme-primary-move-hover: rgba(5, 150, 105, 0.65);
    --theme-screen-bg: rgb(245, 253, 248);
    --theme-board-bg: #ECFAEB;
    --theme-board-border: rgb(5, 150, 105);
    --theme-board-shadow: rgb(6, 78, 59);
    --theme-board-line: rgb(4, 120, 87);
}

/* 🔵 난이도 2: 중 (보통) - 맑고 청명한 딥 오션 블루 (기본값) */
.theme-diff-normal {
    --theme-primary: rgb(2, 132, 199);
    --theme-primary-dark: rgb(3, 105, 161);
    --theme-primary-light: rgb(56, 189, 248);
    --theme-primary-bg: rgb(240, 249, 255);
    --theme-primary-tint: rgb(224, 242, 254);
    --theme-primary-border: rgb(186, 230, 253);
    --theme-primary-hover: rgba(2, 132, 199, 0.15);
    --theme-primary-move: rgba(2, 132, 199, 0.35);
    --theme-primary-move-hover: rgba(2, 132, 199, 0.65);
    --theme-screen-bg: rgb(246, 250, 254);
    --theme-board-bg: #E8F7FF;
    --theme-board-border: rgb(2, 132, 199);
    --theme-board-shadow: rgb(3, 105, 161);
    --theme-board-line: rgb(2, 90, 150);
}

/* 🟣 난이도 3: 상 (숙련) - 쿨 딥 인디고 바이올렛 (레드와 완전히 분리된 쿨 퍼플) */
.theme-diff-hard {
    --theme-primary: rgb(147, 51, 234);
    --theme-primary-dark: rgb(107, 33, 168);
    --theme-primary-light: rgb(192, 132, 252);
    --theme-primary-bg: rgb(250, 245, 255);
    --theme-primary-tint: rgb(243, 232, 255);
    --theme-primary-border: rgb(233, 213, 255);
    --theme-primary-hover: rgba(147, 51, 234, 0.15);
    --theme-primary-move: rgba(147, 51, 234, 0.35);
    --theme-primary-move-hover: rgba(147, 51, 234, 0.65);
    --theme-screen-bg: rgb(251, 248, 254);
    --theme-board-bg: #EAE9FD;
    --theme-board-border: rgb(126, 34, 206);
    --theme-board-shadow: rgb(88, 28, 135);
    --theme-board-line: rgb(107, 33, 168);
}

/* 🌌 난이도 4: 극악 (신) - 미드나잇 건메탈 & 다크 티타늄 테마 */
.theme-diff-hell {
    --theme-primary: rgb(39, 45, 60);
    --theme-primary-dark: rgb(21, 25, 36);
    --theme-primary-light: rgb(79, 88, 110);
    --theme-primary-bg: rgb(241, 243, 249);
    --theme-primary-tint: rgb(225, 229, 238);
    --theme-primary-border: rgb(201, 207, 220);
    --theme-primary-hover: rgba(39, 45, 60, 0.15);
    --theme-primary-move: rgba(39, 45, 60, 0.35);
    --theme-primary-move-hover: rgba(39, 45, 60, 0.65);
    --theme-screen-bg: rgb(246, 248, 252);
    --theme-board-bg: rgb(208, 216, 230);
    --theme-board-border: rgb(45, 55, 75);
    --theme-board-shadow: rgb(15, 20, 30);
    --theme-board-line: rgb(55, 68, 90);
}

/* ── 최상위 루트 컨테이너 및 폰트 설정 (가평한석봉체 Regular) ── */
* {
    margin: 0;
    padding: 0;
    -unity-font: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
    -unity-font-definition: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
}

Label, Button, TextField {
    -unity-font: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
    -unity-font-definition: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
}

.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    background-color: var(--theme-screen-bg);
    padding: 0;
}

.screen-container {
    width: 100%;
    height: 100%;
}

/* ══════════════════════════════════════════ */
/* 1. 메인 메뉴 화면 (Main Menu Styles) */
/* ══════════════════════════════════════════ */

.main-menu-screen {
    align-items: center;
    justify-content: space-around;
    padding: 36px 20px;
    background-color: var(--theme-screen-bg);
}

.menu-title-area {
    align-items: center;
    margin-bottom: 16px;
}

.menu-title-hanja {
    font-size: 72px;
    color: var(--theme-primary);
    -unity-font-style: bold;
    letter-spacing: 22px;
    margin-bottom: -4px;
}

.menu-title-korean {
    font-size: 34px;
    color: rgb(30, 41, 59);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.menu-subtitle {
    font-size: 16px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

/* ── 난이도 선택 영역 ── */
.difficulty-section {
    width: 100%;
    max-width: 580px;
    align-items: center;
    margin-bottom: 16px;
}

.section-title {
    font-size: 20px;
    color: rgb(51, 65, 85);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.difficulty-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.diff-card-wrapper {
    position: relative;
    width: 100%;
    height: 96px;
    margin-bottom: 12px;
}

.diff-card-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 5px;
    border-radius: 14px;
    background-color: rgb(203, 213, 225);
    border-width: 0;
}

.diff-card-wrapper--selected .diff-card-shadow {
    background-color: var(--theme-primary-dark);
}

.diff-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    border-radius: 14px;
    padding: 12px 14px;
    justify-content: space-evenly;
    flex-direction: row;
    align-items: center;
    transition-property: translate, border-color, background-color;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.diff-card:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.diff-card-wrapper--selected .diff-card {
    background-color: var(--theme-primary-tint);
    border-color: var(--theme-primary);
    border-width: 2px;
}

.diff-card-title {
    font-size: 25px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    align-self: center;
}

.diff-title-easy {
    color: rgb(22, 163, 74);
}

.diff-title-normal {
    color: rgb(2, 132, 199);
}

.diff-title-hard {
    color: rgb(147, 51, 234);
}

.diff-title-hell {
    color: rgb(39, 45, 60);
}

.diff-card-desc {
    font-size: 21px;
    color: rgb(100, 116, 139);
    -unity-text-align: middle-center;
}

/* ── 메인 액션 버튼 ── */
.menu-action-area {
    width: 100%;
    max-width: 480px;
    align-items: center;
}

.menu-btn-wrapper {
    position: relative;
    width: 100%;
    height: 82px;
    margin: 6px 0;
}

.menu-btn-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 16px;
    border-width: 0;
}

.menu-btn-shadow-start {
    background-color: var(--theme-primary-dark);
}

.menu-btn-shadow-rules {
    background-color: rgb(203, 213, 225);
}

.menu-btn-shadow-language {
    background-color: rgb(203, 213, 225);
}

.menu-btn {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 14px 0;
    font-size: 30px;
    -unity-font-style: bold;
    border-radius: 16px;
    margin: 0;
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.08s;
}

.menu-btn-start {
    background-color: var(--theme-primary);
    border-color: var(--theme-primary-light);
    border-width: 2px;
    color: rgb(255, 255, 255);
}

.menu-btn-start:hover {
    background-color: var(--theme-primary-dark);
    translate: 0 -2px;
}

.menu-btn-start:active {
    translate: 0 4px;
}

.menu-btn-rules {
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    color: rgb(51, 65, 85);
    font-size: 24px;
}

.menu-btn-rules:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.menu-btn-rules:active {
    translate: 0 4px;
}

.menu-btn-shadow-haptic {
    background-color: rgb(203, 213, 225);
}

.menu-btn-haptic {
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    color: rgb(51, 65, 85);
    font-size: 21px;
}

.menu-btn-haptic:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.menu-btn-haptic:active {
    translate: 0 4px;
}

.menu-btn-language {
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    color: rgb(51, 65, 85);
    font-size: 21px;
}

.menu-btn-language:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.menu-btn-language:active {
    translate: 0 4px;
}

/* ══════════════════════════════════════════ */
/* 2. 인게임 플레이 화면 (Game Play Styles) */
/* ══════════════════════════════════════════ */

.game-play-screen {
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    margin: 0;
}

/* ── 헤더 영역 ── */
.header {
    width: 100%;
    max-width: 1020px;
    align-items: center;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.header-top-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 2px;
}

.header-top-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 4px;
    border-radius: 14px;
    background-color: rgb(203, 213, 225);
    border-width: 0;
}

.header-top {
    position: relative;
    height: 75px;
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    border-radius: 14px;
    padding: 8px 14px;
}

.header-buttons {
    height: 100%;
    flex-direction: row;
    font-size: 21px;
    align-items: stretch;
}

.game-title {
    font-size: 24px;
    color: rgb(30, 41, 59);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* (Turn-info 텍스트 제거됨 - 보드 색상으로 턴 구분) */

/* ── 플레이어 / AI 패널 ── */
.player-panel-wrapper {
    position: relative;
    width: 100%;
    height: 210px;
    max-width: 1020px;
    margin: 3px 0;
    flex-shrink: 0;
}

.player-panel-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 16px;
    border-width: 0;
}

.han-panel-shadow {
    background-color: rgb(220, 38, 38);
}

.cho-panel-shadow {
    background-color: var(--theme-primary);
}

.player-panel {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 16px;
    border-width: 2px;
    padding: 8px 12px;
}

.han-panel {
    border-color: rgb(254, 202, 202);
}

.cho-panel {
    border-color: var(--theme-primary-border);
}

.panel-status-row {
    position: relative;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 50px;
    flex-shrink: 0;
}

.han-status-row {
    margin-top: 6px;
    margin-bottom: 0px;
}

.cho-panel .panel-status-row {
    margin-top: 0px;
    margin-bottom: 6px;
}

.discard-btn-spacer {
    width: 195px;
}

.side-label {
    font-size: 25px;
    -unity-font-style: bold;
}

.han-label {
    color: rgb(220, 38, 38);
}

.cho-label {
    color: var(--theme-primary);
}

/* ── 코스트 & 전력 메트릭스 박스 (패널 가로 정중앙 배치) ── */
.panel-metrics {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.cost-box {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-border);
    border-width: 2px;
    border-radius: 8px;
    padding: 3px 8px;
}

.field-box {
    margin-left: 6px;
    background-color: rgb(240, 253, 244);
    border-color: rgb(187, 247, 208);
}

.cost-label {
    font-size: 22px;
    color: var(--theme-primary);
    -unity-font-style: bold;
}

.field-label {
    color: rgb(22, 163, 74);
}

/* ── 漢 패널 텍스트/박스 ── */
.han-panel .cost-box {
    background-color: rgb(254, 242, 242);
    border-color: rgb(254, 202, 202);
}

.han-panel .field-box {
    background-color: rgb(255, 247, 237);
    border-color: rgb(254, 215, 170);
}

.han-panel .cost-label {
    color: rgb(220, 38, 38);
}

.han-panel .field-label {
    color: rgb(234, 88, 12);
}

.han-panel .card-cost-badge {
    background-color: rgb(220, 38, 38);
}

.han-panel .card-name-label {
    color: rgb(185, 28, 28);
}

/* ── 손패 카드 컨테이너 ── */
.hand-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    height: 132px;
    min-height: 132px;
    max-height: 132px;
}

.hand-card-wrapper {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 4px;
}

.hand-card-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 5px;
    border-radius: 12px;
    border-width: 0;
}

.hand-card-shadow-cho {
    background-color: var(--theme-primary);
}

.hand-card-shadow-han {
    background-color: rgb(220, 38, 38);
}

.hand-card-shadow--selected {
    background-color: var(--theme-primary-dark);
}

.hand-card-shadow--discard {
    background-color: rgb(185, 28, 28);
}

.hand-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-color: var(--theme-primary);
    border-width: 2px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
}

.han-panel .hand-card {
    border-color: rgb(220, 38, 38);
}

.hand-card:hover {
    background-color: var(--theme-primary-bg);
}

.han-panel .hand-card:hover {
    background-color: rgb(254, 242, 242);
    translate: 0 0;
}

.hand-card--selected {
    border-color: var(--theme-primary);
    background-color: var(--theme-primary-tint);
    translate: 0 -2px;
}

.hand-card--discard-target {
    border-color: rgb(220, 38, 38);
    border-width: 2.5px;
    background-color: rgb(254, 226, 226);
    translate: 0 -2px;
}

.hand-card--unusable {
    /* 카드 자체의 불투명도는 100% 유지 (뒤 섀도우 박스 투과 방지) */
}

/* ── 소환 불가 전용 딤드 오버레이 엘리먼트 ── */
.hand-card-disabled-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.65);
    pointer-events: none;
}

/* 카드 좌측 코스트 배지 */
.card-cost-badge {
    position: absolute;
    top: 0px;
    left: 0px;
    bottom: 0px;
    background-color: var(--theme-primary);
    border-radius: 10px 0 0 10px;
    padding: 0px;
    width: 38px;
    align-items: center;
    justify-content: center;
}

.card-cost-text {
    font-size: 21px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 카드 중앙 기물 한자 */
.card-piece-label {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.card-piece-cho {
    color: var(--theme-primary);
}

.card-piece-han {
    color: rgb(220, 38, 38);
}

/* 카드 하단 역할/이름 텍스트 */
.card-name-label {
    font-size: 22px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

/* ── 패 버리기 & 한 수 쉼 & 광고 찬스 액션 바 (좌우 배치) ── */
.cho-action-bar {
    position: relative;
    width: 100%;
    max-width: 1020px;
    height: 48px;
    min-height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
    margin: 4px 0;
    flex-shrink: 0;
}

.action-btn-group-left {
    flex-direction: row;
    align-items: center;
}

.action-btn-group-right {
    flex-direction: row;
    align-items: center;
}

.action-btn-wrapper {
    position: relative;
    height: 36px;
    justify-content: center;
}

.action-btn-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 4px;
    border-radius: 10px;
    border-width: 0;
}

.discard-btn-shadow {
    background-color: rgb(203, 213, 225);
}

.pass-btn-shadow {
    background-color: var(--theme-primary-dark);
}

.ad-chance-btn-shadow {
    background-color: rgb(180, 83, 9);
}

.action-btn {
    position: relative;
    padding: 4px 14px;
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    margin: 0;
    transition-property: translate, background-color, border-color, color;
    transition-duration: 0.08s, 0.08s, 0.08s, 0.08s;
}

/* 패 버리기 버튼 */
.discard-btn {
    color: rgb(51, 65, 85);
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
}

.discard-btn:hover {
    background-color: rgb(241, 245, 249);
    border-color: rgb(148, 163, 184);
}

.discard-btn:active {
    translate: 0 3px;
}

.discard-btn--active {
    background-color: rgb(220, 38, 38);
    border-color: rgb(185, 28, 28);
    color: rgb(255, 255, 255);
}

/* 한 수 쉼 버튼 */
.pass-btn {
    color: rgb(255, 255, 255);
    background-color: var(--theme-primary);
    border-color: var(--theme-primary-light);
}

.pass-btn:hover {
    background-color: var(--theme-primary-dark);
    border-color: var(--theme-primary);
}

.pass-btn:active {
    translate: 0 3px;
}

/* 광고 찬스 버튼 */
.ad-chance-btn {
    color: rgb(255, 255, 255);
    background-color: rgb(245, 158, 11);
    border-color: rgb(251, 191, 36);
}

.ad-chance-btn:hover {
    background-color: rgb(217, 119, 6);
    border-color: rgb(245, 158, 11);
}

.ad-chance-btn:active {
    translate: 0 3px;
}

.ad-chance-btn--active {
    background-color: rgb(220, 38, 38);
    border-color: rgb(248, 113, 113);
    color: rgb(255, 255, 255);
}

.ad-chance-btn--disabled {
    opacity: 0.5;
    background-color: rgb(148, 163, 184);
    border-color: rgb(203, 213, 225);
    color: rgb(241, 245, 249);
}

/* ── 중앙 보드 영역 ── */
.board-area {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    max-width: 1020px;
    margin: 4px 0;
}

.board-wrapper {
    position: relative;
    width: 100%;
}

.board-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 8px;
    border-radius: 18px;
    background-color: var(--theme-board-shadow);
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.25s;
}

.board-container {
    position: relative;
    width: 100%;
    background-color: var(--theme-board-bg);
    border-color: var(--theme-board-border);
    border-width: 3px;
    border-radius: 18px;
    overflow: hidden;
    transition-property: background-color, border-color;
    transition-duration: 0.25s;
}

/* ── 격자 배경 & 교차점 ── */
.grid-background {
    position: absolute;
    left: 2%;
    top: 2%;
    right: 2%;
    bottom: 2%;
}

.grid-line-h {
    position: absolute;
    left: 5.5555%;
    right: 5.5555%;
    height: 2px;
    translate: 0 -1px;
    background-color: var(--theme-board-line);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.grid-line-v {
    position: absolute;
    top: 5%;
    bottom: 5%;
    width: 2px;
    translate: -1px 0;
    background-color: var(--theme-board-line);
    transition-property: background-color;
    transition-duration: 0.25s;
}

/* 🔴 AI(漢) 턴일 때 보드판 색상 - 붉은색/루비/크림슨 계열 */
.turn-han .board-container {
    background-color: rgb(252, 232, 232);
    border-color: rgb(239, 68, 68);
}

.turn-han .board-shadow {
    background-color: rgb(185, 28, 28);
}

.turn-han .grid-line-h,
.turn-han .grid-line-v {
    background-color: rgb(220, 100, 100);
}

.intersections-grid {
    position: absolute;
    left: 2%;
    top: 2%;
    right: 2%;
    bottom: 2%;
    flex-direction: column;
}

.board-row {
    flex-direction: row;
    width: 100%;
    height: 10%;
    align-items: center;
    justify-content: flex-start;
}

.intersection {
    width: 11.1111%;
    height: 100%;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    position: relative;
}

.intersection:hover {
    background-color: var(--theme-primary-hover);
    border-radius: 50%;
}

/* ── 기물 섀도우 엘리먼트 ── */
.piece-shadow {
    position: absolute;
    width: 86%;
    height: 86%;
    border-radius: 50%;
    translate: 0 7px;
    border-width: 0;
    transition-property: translate;
    transition-duration: 0.12s;
}

.piece-shadow-cho {
    background-color: var(--theme-primary);
}

.piece-shadow-han {
    background-color: rgb(220, 38, 38);
}

/* ── 기물 본체 ── */
.piece {
    position: relative;
    width: 86%;
    height: 86%;
    border-radius: 50%;
    border-width: 2px;
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 28px;
    -unity-font-style: bold;
    transition-property: translate;
    transition-duration: 0.12s;
}

/* 초(楚) 기물 */
.piece-cho {
    color: var(--theme-primary);
    border-color: var(--theme-primary-border);
}

/* 한(漢) 기물 */
.piece-han {
    color: rgb(220, 38, 38);
    border-color: rgb(254, 202, 202);
}

/* 기물 상태 하이라이트 & 선택 시 Y축 리프팅(-5px, 본체와 섀도우 함께 이동) */
.intersection--selected {
    background-color: rgba(250, 204, 21, 0.45);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(202, 138, 4);
}

.intersection--selected .piece {
    translate: 0 -3px;
}

.intersection--selected .piece-shadow {
    translate: 0 4px;
}

.intersection--movable {
    background-color: var(--theme-primary-move);
    border-radius: 50%;
}

.intersection--movable:hover {
    background-color: var(--theme-primary-move-hover);
}

.intersection--attackable {
    background-color: rgba(220, 38, 38, 0.45);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(220, 38, 38);
}

.intersection--attackable:hover {
    background-color: rgba(220, 38, 38, 0.7);
}

.intersection--spawnable {
    background-color: var(--theme-primary-move);
    border-width: 2px;
    border-color: var(--theme-primary);
    border-radius: 50%;
}

.intersection--spawnable:hover {
    background-color: var(--theme-primary-move-hover);
}

.intersection--check {
    background-color: rgba(220, 38, 38, 0.45);
    border-radius: 50%;
}

.intersection--last-from {
    background-color: rgba(250, 204, 21, 0.35);
    border-radius: 50%;
}

.intersection--eliminate-target {
    background-color: rgba(239, 68, 68, 0.5);
    border-radius: 50%;
    border-width: 3px;
    border-color: rgb(239, 68, 68);
    transition-property: scale;
    transition-duration: 0.15s;
}

.intersection--eliminate-target:hover {
    background-color: rgba(220, 38, 38, 0.85);
    scale: 1.12 1.12;
}

.intersection--eliminate-target .piece {
    border-color: rgb(239, 68, 68);
    border-width: 3px;
    background-color: rgb(254, 226, 226);
    color: rgb(185, 28, 28);
    scale: 1.15 1.15;
    translate: 0 -4px;
}

.intersection--eliminate-target .piece-shadow {
    scale: 1.15 1.15;
    translate: 0 4px;
}

/* ── 광고 시청 모달 ── */
.ad-modal-badge {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(217, 119, 6);
    background-color: rgb(254, 243, 199);
    border-color: rgb(252, 211, 77);
    border-width: 1.5px;
    border-radius: 20px;
    padding: 4px 12px;
}

.ad-progress-bar-fill {
    transition-property: width;
    transition-duration: 1.2s;
    transition-timing-function: ease-out;
}

/* ── 유틸 버튼 ── */
.control-btn {
    padding: 6px 12px;
    font-size: 15px;
    color: rgb(51, 65, 85);
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    border-radius: 10px;
    -unity-font-style: bold;
    transition-property: translate;
    transition-duration: 0.08s;
}

.control-btn:hover {
    background-color: rgb(248, 250, 252);
    translate: 0 -1px;
}

.control-btn:active {
    translate: 0 2px;
}

.btn-sm {
    padding: 5px 10px;
    font-size: 21px;
}

.btn-difficulty {
    margin-right: 6px;
    color: var(--theme-primary-dark);
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-border);
}

.btn-difficulty:hover {
    background-color: var(--theme-primary-tint);
}

.btn-language {
    margin-right: 6px;
    color: rgb(51, 65, 85);
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
}

.btn-language:hover {
    background-color: rgb(241, 245, 249);
}

.btn-menu {
    margin-left: 6px;
    color: rgb(100, 116, 139);
}

/* ══════════════════════════════════════════ */
/* 3. 모달 팝업 공통 */
/* ══════════════════════════════════════════ */

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-card-wrapper {
    position: relative;
    width: 86%;
    max-width: 1000px;
}

.modal-card-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 20px;
    background-color: rgb(203, 213, 225);
    border-width: 0;
}

.modal-card {
    position: relative;
    width: 100%;
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2.5px;
    border-radius: 20px;
    padding: 28px 22px;
    align-items: center;
}

.modal-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 6px;
}

.modal-title--win {
    color: var(--theme-primary);
}

.modal-title--lose {
    color: rgb(220, 38, 38);
}

.modal-title--draw {
    color: rgb(100, 116, 139);
}

.modal-desc {
    font-size: 17px;
    color: rgb(100, 116, 139);
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.modal-stats {
    width: 100%;
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 20px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 0;
}

.stat-label {
    font-size: 15px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

.stat-value {
    color: rgb(51, 65, 85);
    -unity-font-style: bold;
}

.modal-btn-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 4px;
    border-radius: 14px;
    border-width: 0;
}

.modal-btn-shadow-share {
    background-color: rgb(202, 138, 4);
}

.modal-btn-shadow-ad {
    background-color: rgb(190, 95, 10);
}

.modal-btn-shadow-primary {
    background-color: var(--theme-primary-dark);
}

.modal-btn-shadow-secondary {
    background-color: rgb(203, 213, 225);
}

.modal-btn {
    position: relative;
    width: 100%;
    height: 100%;
    font-size: 22px;
    -unity-font-style: bold;
    border-radius: 14px;
    margin: 0;
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.08s;
}

.modal-btn:active {
    translate: 0 3px;
}

.modal-btn-share {
    background-color: rgb(254, 240, 138);
    border-color: rgb(234, 179, 8);
    border-width: 1.5px;
    color: rgb(113, 63, 18);
}

.modal-btn-share:hover {
    background-color: rgb(253, 224, 71);
    translate: 0 -1px;
}

.modal-btn-ad {
    background-color: rgb(245, 158, 11);
    border-color: rgb(251, 191, 36);
    border-width: 1.5px;
    color: rgb(255, 255, 255);
}

.modal-btn-ad:hover {
    background-color: rgb(217, 119, 6);
    translate: 0 -1px;
}

.modal-btn-shadow-review {
    background-color: rgb(30, 64, 175);
}

.modal-btn-review {
    background-color: rgb(37, 99, 235);
    border-color: rgb(96, 165, 250);
    border-width: 1.5px;
    color: rgb(255, 255, 255);
}

.modal-btn-review:hover {
    background-color: rgb(29, 78, 216);
    translate: 0 -1px;
}

.modal-btn-primary {
    background-color: var(--theme-primary);
    border-color: var(--theme-primary-light);
    border-width: 1.5px;
    color: rgb(255, 255, 255);
}

.modal-btn-primary:hover {
    background-color: var(--theme-primary-dark);
    translate: 0 -1px;
}

.modal-btn-secondary {
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    color: rgb(51, 65, 85);
}

.modal-btn-secondary:hover {
    background-color: rgb(241, 245, 249);
    translate: 0 -1px;
}

/* ── 4. 게임 오버 인라인 결과창 (보드 아래 공간 배치) ── */
.game-play-screen.state--game-over .han-panel-wrapper,
.game-play-screen.state--game-over .cho-panel-wrapper,
.game-play-screen.state--game-over .cho-action-bar {
    display: none;
}

.game-play-screen.state--game-over .board-area {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 4px;
}

.game-over-inline-area {
    position: relative;
    width: 100%;
    max-width: 1020px;
    margin: 30px 0 20px 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.game-over-inline-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 18px;
    background-color: var(--theme-primary-dark);
    border-width: 0;
}

.game-over-inline-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 18px;
    border-width: 2.5px;
    border-color: var(--theme-primary-border);
    padding: 10px 14px;
    flex-direction: column;
    justify-content: space-between;
}

.inline-title-row {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}

.inline-modal-title {
    font-size: 40px;
    -unity-font-style: bold;
    margin: 8px 0;
}

.inline-modal-title--win {
    color: rgb(5, 150, 105);
}

.inline-modal-title--lose {
    color: rgb(220, 38, 38);
}

.inline-modal-title--draw {
    color: rgb(217, 119, 6);
}

.inline-modal-badge {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: var(--theme-primary);
    border-radius: 12px;
    padding: 4px 10px;
}

/* 외통수 분석 섹션 */
.inline-review-section {
    background-color: var(--theme-primary-bg);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--theme-primary-border);
    padding: 8px 40px;
    margin-bottom: 6px;
}

.inline-review-desc {
    font-size: 30px;
    color: rgb(30, 41, 59);
    white-space: normal;
    -unity-font-style: normal;
    line-height: 19px;
}

/* 통계 2x2 그리드 */
.inline-stats-grid {
    flex-direction: column;
    margin-bottom: 6px;
}

.inline-stats-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 60px;
}

.inline-stat-chip {
    flex: 1;
    height: 100%;
    background-color: rgb(248, 250, 252);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
    padding: 6px 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.inline-chip-label {
    font-size: 22px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

.inline-chip-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
}

/* 액션 버튼 행 */
.inline-actions-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 55px;
}

.inline-btn-wrapper {
    flex: 1;
    height: 100%;
}

.inline-action-btn {
    font-size: 23px;
    border-radius: 12px;
}

/* ── 복기/외통수 시각적 하이라이트 (기물 본연의 색상과 폰트 보존) ── */
.intersection--review-attacker {
    background-color: rgba(239, 68, 68, 0.3);
    border-radius: 50%;
    border-width: 3px;
    border-color: rgb(239, 68, 68);
}

.intersection--review-attacker .piece {
    translate: 0 -3px;
}

.intersection--review-controller {
    background-color: rgba(147, 51, 234, 0.25);
    border-radius: 50%;
    border-width: 2.5px;
    border-color: rgb(147, 51, 234);
}

.intersection--review-target-king {
    background-color: rgba(220, 38, 38, 0.45);
    border-radius: 50%;
    border-width: 3.5px;
    border-color: rgb(220, 38, 38);
}

.intersection--review-target-king .piece {
    translate: 0 -4px;
}

.intersection--review-blocked-pos {
    background-color: rgba(239, 68, 68, 0.22);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(220, 38, 38, 0.6);
}

/* ── 룰 가이드 모달 ── */
.rule-modal-card {
    width: 100%;
    max-height: 100%;
}

.rule-scroll-view {
    width: 100%;
    max-height: 100%;
    margin-bottom: 18px;
}

.rule-item {
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 10px;
}

.rule-item-title {
    font-size: 25px;
    color: var(--theme-primary);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.rule-item-desc {
    font-size: 22px;
    color: rgb(51, 65, 85);
    white-space: normal;
}

/* ══════════════════════════════════════════ */
/* 4. 장군 / 멍군 다이내믹 알림 배너 */
/* ══════════════════════════════════════════ */

.callout-banner {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    min-width: 260px;
    max-width: 440px;
    align-items: center;
    justify-content: center;
    z-index: 90;
    pointer-events: none;
    flex-shrink: 0;
    transition-property: opacity, scale, translate;
    transition-duration: 0.28s, 0.28s, 0.28s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out;
}

.callout-banner--hidden {
    opacity: 0;
    scale: 0.5 0.5;
    translate: -50% -42%;
    display: none;
}

.callout-banner--visible {
    opacity: 1;
    scale: 1 1;
    translate: -50% -50%;
    display: flex;
}

.callout-card-frame {
    min-width: 220px;
    padding: 16px 36px 14px 36px;
    border-radius: 18px;
    border-width: 2.5px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: rgb(255, 255, 255);
}

/* ── 장군 (將 軍) 테마 ── */
.callout-banner--check .callout-card-frame {
    border-color: rgb(239, 68, 68);
    background-color: rgb(254, 242, 242);
}

.callout-banner--check .callout-hanja {
    color: rgb(220, 38, 38);
}

.callout-banner--check .callout-divider-line {
    background-color: rgb(248, 113, 113);
}

.callout-banner--check .callout-subtitle {
    color: rgb(185, 28, 28);
}

/* ── 멍군 (應 將) 테마 ── */
.callout-banner--escape .callout-card-frame {
    border-color: var(--theme-primary);
    background-color: var(--theme-primary-bg);
}

.callout-banner--escape .callout-hanja {
    color: var(--theme-primary);
}

.callout-banner--escape .callout-divider-line {
    background-color: var(--theme-primary-light);
}

.callout-banner--escape .callout-subtitle {
    color: var(--theme-primary-dark);
}

/* ── 공통 타이포그래피 & 데코 ── */
.callout-hanja {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 16px;
    -unity-text-align: middle-center;
    margin-right: -16px;
    margin-bottom: 2px;
    white-space: nowrap;
}

.callout-divider-line {
    width: 80%;
    min-width: 140px;
    height: 2px;
    margin: 6px 0 8px 0;
}

.callout-subtitle {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
